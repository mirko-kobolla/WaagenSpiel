@page "/"

<PageTitle>Waagenspiel | iPad-Version</PageTitle>

@if (!SpielGestartet)
{
	<div class="game-shell setup-shell">
		<section class="setup-panel">
			<p class="eyebrow">Vorbereitung</p>
			<h1>Waagenspiel</h1>
			<p class="subtitle">Richtet die gemeinsame Partie ein, bevor der erste Zug beginnt.</p>

			<div class="setup-field">
				<label for="group-count">Anzahl der Gruppen</label>
				<select id="group-count" @bind="AnzahlGruppen" @bind:after="GruppenanzahlGeaendert">
					@for (var count = 2; count <= 8; count++)
					{
						<option value="@count">@count Gruppen</option>
					}
				</select>
			</div>

			<div class="group-name-list">
				@for (var index = 0; index < AnzahlGruppen; index++)
				{
					var groupIndex = index;
					<div class="setup-field">
						<label for="group-@groupIndex">Name der Gruppe @(groupIndex + 1)</label>
						<input id="group-@groupIndex" @bind="Gruppennamen[groupIndex]" maxlength="30" />
					</div>
				}
			</div>

			<button class="primary-action start-action" @onclick="StartGame">Partie starten <span>→</span></button>
		</section>
	</div>
}
else
{
<div class="game-shell">
	<header class="game-header">
		<div>
			<p class="eyebrow">iPad-Version</p>
			<h1>Waagenspiel</h1>
			<p class="subtitle">Finde die geheime Kombination der aktuellen Gruppe.</p>
		</div>
		<div class="round-badge">
			<span>Am Zug</span>
			<strong>@Manager.HoleAktuelleGruppe().Name</strong>
			<small>von @Manager.Gruppen.Count</small>
		</div>
	</header>

	<section class="status-strip" aria-live="polite">
		<span class="status-dot"></span>
		<div>
			<strong>Spielstatus</strong>
			<span>@StatusText</span>
		</div>
	</section>

	<main>
		<section class="scale-grid" aria-label="Waagen">
			@for (var scaleIndex = 0; scaleIndex < Waagen.Count; scaleIndex++)
			{
				var scale = Waagen[scaleIndex];
				<article class="scale-card">
					<div class="scale-card-header">
						<div>
							<span class="card-kicker">@(scaleIndex == 0 ? "Hauptwaage" : "Nebenwaage")</span>
							<h2>@GewichtsStatus(scale)</h2>
						</div>
						<span class="scale-icon" aria-hidden="true">⚖</span>
					</div>
					<div class="scale-panels">
						<div class="pan">
							<span class="pan-label">Links</span>
							<div class="placed-stones">
								@foreach (var stone in scale.LinkeSeite)
								{
									<span class="mini-stone @StoneClass(stone)">@stone.Farbe</span>
								}
							</div>
							<strong>Gewicht verborgen</strong>
						</div>
						<div class="pan-divider">vs.</div>
						<div class="pan">
							<span class="pan-label">Rechts</span>
							<div class="placed-stones">
								@foreach (var stone in scale.RechteSeite)
								{
									<span class="mini-stone @StoneClass(stone)">@stone.Farbe</span>
								}
							</div>
							<strong>Gewicht verborgen</strong>
						</div>
					</div>
				</article>
			}
		</section>

		<section class="selection-panel">
			<div class="section-heading">
				<div>
					<span class="card-kicker">Steine von @Manager.HoleAktuelleGruppe().Name</span>
					<h2>Stein auswählen</h2>
				</div>
				<span class="remaining-count">@VerbleibendeSteine() verfügbar</span>
			</div>

			<div class="stone-grid">
				@foreach (var item in Manager.HoleAktuelleGruppe().Steine.Select((stone, index) => new { stone, index }))
				{
					<button class="stone-button @StoneClass(item.stone) @(SelectedStone == item.stone ? "selected" : "")"
							disabled="@(item.stone.Platziert || SpielBeendet)"
							@onclick="() => SelectStone(item.stone)">
						<span class="stone-dot"></span>
						<span>@item.stone.Farbe</span>
						<small>@SteinHinweis(item.stone)</small>
					</button>
				}
			</div>

			@if (SelectedStone is not null)
			{
				<div class="placement-controls">
					<div>
						<span class="card-kicker">@SelectedStone.Farbe ausgewählt</span>
						<strong>Wo soll der Stein liegen?</strong>
					</div>
					<div class="placement-actions">
						@for (var scaleIndex = 0; scaleIndex < Waagen.Count; scaleIndex++)
						{
							var targetScale = scaleIndex;
							<button class="target-button" @onclick="() => PlaceSelectedStone(targetScale, true)">@(targetScale == 0 ? "Hauptwaage" : "Nebenwaage"), links</button>
							<button class="target-button" @onclick="() => PlaceSelectedStone(targetScale, false)">@(targetScale == 0 ? "Hauptwaage" : "Nebenwaage"), rechts</button>
						}
					</div>
				</div>
			}
		</section>

		<section class="action-row">
			<button class="primary-action" disabled="@(!CanEvaluate || SpielBeendet)" @onclick="EvaluateGame">Zug beenden <span>→</span></button>
			@if (CanGuessWeights && !SpielBeendet)
			{
				<button class="secondary-action" type="button" @onclick="ShowWeightGuess">Gewichte raten</button>
			}
			<button class="secondary-action" @onclick="ResetGame">Neue Partie</button>
		</section>
		<p class="rules-note"><strong>Zug beenden</strong> gibt den Zug frei, sobald die aktuelle Gruppe mindestens zwei eigene Steine platziert hat oder die belegte Hauptwaage ausgeglichen ist. Die Gewichtsabfrage ist freiwillig.</p>

		@if (GewichteRatenSichtbar)
		{
			<section class="guess-panel">
				<div class="section-heading">
					<div>
						<span class="card-kicker">Hauptwaage ausgeglichen</span>
						<h2>Wie schwer sind die Farben?</h2>
					</div>
				</div>
				<p class="guess-note">Trage für jede Farbe das vermutete Gewicht ein.</p>
				<div class="guess-grid">
					@foreach (var color in Farben)
					{
						<label class="guess-field">
							<span class="mini-stone @color.ToLowerInvariant()">@color</span>
							<input type="number" min="1" @bind="GewichtsTipps[color]" />
							<span>g</span>
						</label>
					}
				</div>
				<button class="primary-action" @onclick="CheckWeightGuess">Gewichte prüfen</button>
				@if (!string.IsNullOrWhiteSpace(GewichtsErgebnis))
				{
					<p class="guess-result" aria-live="polite">@GewichtsErgebnis</p>
				}
			</section>
		}
	</main>
</div>
}

@code {
	private SpielManager Manager = new(3);
	private readonly List<Waage> Waagen = new() { new Waage(), new Waage() };
	private readonly List<string> Gruppennamen = new() { "Gruppe 1", "Gruppe 2", "Gruppe 3" };
	private int AnzahlGruppen = 3;
	private bool SpielGestartet;
	private Stein? SelectedStone;
	private string StatusText = "Wähle einen Stein aus, um ihn auf einer Waage zu platzieren.";
	private readonly string[] Farben = { "Rot", "Lila", "Gelb", "Blau", "Grün" };
	private readonly Dictionary<string, int> GewichtsTipps = new();
	private readonly HashSet<string> RichtigGerateneFarben = new();
	private bool GewichteRatenSichtbar;
	private string GewichtsErgebnis = string.Empty;
	private bool SpielBeendet;
	private bool SpielGewonnen;

	private void GruppenanzahlGeaendert()
	{
		while (Gruppennamen.Count < AnzahlGruppen)
		{
			Gruppennamen.Add($"Gruppe {Gruppennamen.Count + 1}");
		}
	}

	private void StartGame()
	{
		GruppenanzahlGeaendert();
		Manager = new SpielManager(AnzahlGruppen);
		for (var index = 0; index < AnzahlGruppen; index++)
		{
			Manager.Gruppen[index].Name = string.IsNullOrWhiteSpace(Gruppennamen[index])
				? $"Gruppe {index + 1}"
				: Gruppennamen[index].Trim();
		}

		SpielGestartet = true;
		SpielBeendet = false;
		SpielGewonnen = false;
		RichtigGerateneFarben.Clear();
		GewichteRatenSichtbar = false;
		SelectedStone = null;
		StatusText = $"{Manager.HoleAktuelleGruppe().Name} beginnt. Wähle einen Stein aus.";
	}

	private void SelectStone(Stein stone)
	{
		if (!stone.Platziert && !SpielBeendet)
		{
			SelectedStone = stone;
			StatusText = $"{stone.Farbe} ausgewählt. Wähle jetzt eine Seite.";
		}
	}

	private void PlaceSelectedStone(int scaleIndex, bool left)
	{
		if (SelectedStone is null || SelectedStone.Platziert)
		{
			return;
		}

		if (left)
		{
			if (scaleIndex == 0 && !IstHauptwaagenKombinationGueltig(true))
			{
				StatusText = "Nicht möglich: Auf der Hauptwaage dürfen links und rechts nicht dieselben Steine liegen.";
				return;
			}

			Waagen[scaleIndex].SteiLinksPlatzieren(SelectedStone);
		}
		else
		{
			if (scaleIndex == 0 && !IstHauptwaagenKombinationGueltig(false))
			{
				StatusText = "Nicht möglich: Auf der Hauptwaage dürfen links und rechts nicht dieselben Steine liegen.";
				return;
			}

			Waagen[scaleIndex].SteinRechtsPlatzieren(SelectedStone);
		}

			StatusText = $"{SelectedStone.Farbe} liegt auf {(scaleIndex == 0 ? "der Hauptwaage" : "der Nebenwaage")}.";
		SelectedStone = null;
	}

	private void EvaluateGame()
	{
		if (!CanEvaluate || SpielBeendet)
		{
			return;
		}

		var mainScale = Waagen[0];
		var group = Manager.HoleAktuelleGruppe();
		var isBalanced = mainScale.IstAusbalanciert();
		SelectedStone = null;
		GewichteRatenSichtbar = false;

		if (AlleSteinePlatziert())
		{
			SpielBeendet = true;
			SpielGewonnen = isBalanced && RichtigGerateneFarben.Count == Farben.Length;
			StatusText = SpielGewonnen
				? "Gewonnen! Alle Steine sind platziert, die Hauptwaage ist ausgeglichen und alle Gewichte wurden richtig geraten."
				: "Verloren. Alle Steine sind platziert, aber die Hauptwaage ist nicht ausgeglichen oder nicht alle Gewichte wurden richtig geraten.";
			return;
		}

		if (Manager.NaechsteGruppe())
		{
			StatusText = isBalanced
				? $"{group.Name} beendet den Zug. Die Hauptwaage ist ausgeglichen. Die Waagen bleiben liegen; {Manager.HoleAktuelleGruppe().Name} ist jetzt dran."
				: $"{group.Name} beendet den Zug. Die Waagen bleiben liegen; {Manager.HoleAktuelleGruppe().Name} ist jetzt dran.";
		}
		else
		{
			StatusText = isBalanced
				? "Alle Gruppen waren an der Reihe. Die Hauptwaage ist ausgeglichen."
				: "Alle Gruppen waren an der Reihe. Starte eine neue Partie für einen weiteren Durchgang.";
		}
	}

	private void ResetGame()
	{
		SpielGestartet = false;
		Manager = new SpielManager(AnzahlGruppen);
		ClearScales();
		SelectedStone = null;
		SpielBeendet = false;
		SpielGewonnen = false;
		RichtigGerateneFarben.Clear();
		GewichteRatenSichtbar = false;
		StatusText = "Wähle die Gruppen und starte eine neue Partie.";
	}

	private void ClearScales()
	{
		foreach (var scale in Waagen)
		{
			scale.LinkeSeite.Clear();
			scale.RechteSeite.Clear();
		}
	}

	private int VerbleibendeSteine() => Manager.HoleAktuelleGruppe().Steine.Count(stone => !stone.Platziert);

	private bool CanEvaluate => Manager.HoleAktuelleGruppe().Steine.Count(stone => stone.Platziert) >= 2 || CanGuessWeights;

	private bool CanGuessWeights => Waagen[0].LinkeSeite.Count + Waagen[0].RechteSeite.Count > 0
		&& Waagen[0].GewichtLinks() == Waagen[0].GewichtRechts();

	private bool AlleSteinePlatziert() => Manager.Gruppen.SelectMany(group => group.Steine).All(stone => stone.Platziert);

	private void ShowWeightGuess()
	{
		GewichteRatenSichtbar = true;
		foreach (var color in Farben)
		{
			GewichtsTipps[color] = 0;
		}
		GewichtsErgebnis = string.Empty;
		StatusText = "Die Hauptwaage ist ausgeglichen. Trage die vermuteten Farbgewichte ein.";
	}

	private void CheckWeightGuess()
	{
		var fehlendeFarben = Farben.Where(color => !GewichtsTipps.TryGetValue(color, out var guess) || guess <= 0).ToList();
		if (fehlendeFarben.Count > 0)
		{
			GewichtsErgebnis = $"Bitte gib noch ein Gewicht für {string.Join(", ", fehlendeFarben)} ein.";
			StatusText = "Die Gewichtsangaben sind noch unvollständig.";
			return;
		}

		var richtigeFarben = Farben.Where(color =>
			Manager.Gruppen.SelectMany(group => group.Steine)
				.Where(stone => stone.Farbe == color)
				.All(stone => stone.Gewicht == GewichtsTipps[color])).ToList();
		foreach (var color in richtigeFarben)
		{
			RichtigGerateneFarben.Add(color);
		}

		if (RichtigGerateneFarben.Count == Farben.Length)
		{
			GewichtsErgebnis = "Richtig! Alle fünf Farbgewichte wurden erraten.";
			StatusText = "Richtig! Alle Gewichte wurden korrekt erraten.";
		}
		else
		{
			GewichtsErgebnis = $"Noch nicht vollständig richtig: {richtigeFarben.Count} von {Farben.Length} Gewichten stimmen in diesem Versuch. Insgesamt richtig geraten: {RichtigGerateneFarben.Count} von {Farben.Length}.";
			StatusText = "Einige Gewichte stimmen noch nicht. Versuche es erneut.";
		}
	}

	private bool IstHauptwaagenKombinationGueltig(bool left)
	{
		if (SelectedStone is null)
		{
			return false;
		}

		var leftColors = Waagen[0].LinkeSeite.Select(stone => stone.Farbe).ToList();
		var rightColors = Waagen[0].RechteSeite.Select(stone => stone.Farbe).ToList();
		(left ? leftColors : rightColors).Add(SelectedStone.Farbe);

		return !leftColors.OrderBy(color => color).SequenceEqual(rightColors.OrderBy(color => color));
	}

	private static string GewichtsStatus(Waage scale)
	{
		if (scale.LinkeSeite.Count == 0 && scale.RechteSeite.Count == 0)
		{
			return "Noch keine Steine platziert";
		}

		if (scale.GewichtLinks() == scale.GewichtRechts())
		{
			return "Im Gleichgewicht";
		}

		return scale.GewichtLinks() > scale.GewichtRechts()
			? "Linke Seite schwerer"
			: "Rechte Seite schwerer";
	}

	private static string StoneClass(Stein stone) => stone.Farbe.ToLowerInvariant();

	private static string SteinHinweis(Stein stone) => stone.Farbe == "Gelb"
		? "10"
		: stone.Platziert ? "platziert" : "unbekannt";
}
