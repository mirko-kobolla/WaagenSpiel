@page "/"
@inject IJSRuntime JS
@using System.Text.Json

<PageTitle>Waagenspiel | iPad-Version</PageTitle>

@if (!SpielGestartet)
{
	<div class="game-shell setup-shell">
		<section class="setup-panel">
			<p class="eyebrow">Vorbereitung</p>
			<h1>Waagenspiel</h1>
			<p class="subtitle">Richtet die gemeinsame Partie ein, bevor der erste Zug beginnt.</p>

			<div class="mode-choice" role="radiogroup" aria-label="Spielmodus">
				<button type="button" class="mode-card @(PeerMode == "local" ? "selected" : "")" @onclick='() => SetPeerMode("local")'>
					<strong>Ein Gerät</strong>
					<span>Alle Teams spielen gemeinsam auf diesem Gerät.</span>
				</button>
				<button type="button" class="mode-card @(PeerMode == "host" || PeerMode == "join" ? "selected" : "")" @onclick='() => SetPeerMode("host")'>
					<strong>Mehrere Geräte</strong>
					<span>Teams verbinden sich über PeerJS.</span>
				</button>
			</div>

			@if (PeerMode == "local")
			{
				<div class="setup-field">
					<label for="group-count">Anzahl der Gruppen</label>
					<select id="group-count" @bind="AnzahlGruppen" @bind:after="GruppenanzahlGeaendert">
						@for (var count = 2; count <= 8; count++)
						{
							<option value="@count">@count Gruppen</option>
						}
					</select>
				</div>

				<div class="group-name-list">
					@for (var index = 0; index < AnzahlGruppen; index++)
					{
						var groupIndex = index;
						<div class="setup-field">
							<label for="group-@groupIndex">Name der Gruppe @(groupIndex + 1)</label>
							<input id="group-@groupIndex" @bind="Gruppennamen[groupIndex]" maxlength="30" />
						</div>
					}
				</div>

				<button class="primary-action start-action" @onclick="StartGame">Partie starten <span>→</span></button>
			}
			else
			{
				<div class="peer-choice">
					<button type="button" class="secondary-action @(PeerMode == "host" ? "selected" : "")" @onclick='() => SetPeerMode("host")'>Raum erstellen</button>
					<button type="button" class="secondary-action @(PeerMode == "join" ? "selected" : "")" @onclick='() => SetPeerMode("join")'>Raum beitreten</button>
				</div>

				@if (PeerMode == "host")
				{
					@if (string.IsNullOrWhiteSpace(PeerRoomId))
					{
						<div class="setup-field">
							<label for="host-name">Name der Spielleitung</label>
							<input id="host-name" @bind="PeerTeamName" maxlength="30" placeholder="z. B. Moderation" />
						</div>
						<button class="primary-action start-action" @onclick="CreatePeerRoom">Peer-Raum erstellen <span>→</span></button>
					}
					else
					{
						<div class="room-code">
							<span>Raum-ID</span>
							<strong>@PeerRoomId</strong>
						</div>
						<div class="peer-lobby">
							<h2>Verbundene Teams</h2>
							@if (LobbyTeams.Count == 0)
							{
								<p class="subtitle">Noch wartet kein Team.</p>
							}
							@foreach (var team in LobbyTeams)
							{
								<div class="lobby-team">
									<strong>@team.Name</strong>
								</div>
							}
						</div>
						<button class="primary-action start-action" disabled="@(LobbyTeams.Count == 0)" @onclick="StartPeerGame">
							Peer-Partie starten <span>→</span>
						</button>
					}
				}
				else
				{
					<div class="setup-field">
						<label for="room-id">Raum-ID</label>
						<input id="room-id" @bind="PeerRoomId" maxlength="6" placeholder="6 Zeichen, z. B. 7K4M2P" />
					</div>
					<div class="setup-field">
						<label for="team-name">Name des Teams</label>
						<input id="team-name" @bind="PeerTeamName" maxlength="30" placeholder="Teamname" />
					</div>
					<button class="primary-action start-action" disabled="@(PeerJoining || PeerJoined || string.IsNullOrWhiteSpace(PeerRoomId) || string.IsNullOrWhiteSpace(PeerTeamName))" @onclick="JoinPeerRoom">
						Team hinzufügen <span>→</span>
					</button>
					@if (!string.IsNullOrWhiteSpace(PeerConnectionStatus))
					{
						<p class="guess-result">@PeerConnectionStatus</p>
					}
				}
			}
		</section>
	</div>
}
else
{
<div class="game-shell">
	<header class="game-header">
		<div>
			<p class="eyebrow">iPad-Version</p>
			<h1>Waagenspiel</h1>
			<p class="subtitle">Finde die geheime Kombination der aktuellen Gruppe.</p>
		</div>
		<div class="round-badge">
			<span>Am Zug</span>
			<strong>@Manager.HoleAktuelleGruppe().Name</strong>
			<small>von @Manager.Gruppen.Count</small>
		</div>
	</header>

	<section class="status-strip" aria-live="polite">
		<span class="status-dot"></span>
		<div>
			<strong>Spielstatus</strong>
			<span>@StatusText</span>
		</div>
	</section>

	<main>
		<section class="scale-grid" aria-label="Waagen">
			@for (var scaleIndex = 0; scaleIndex < Waagen.Count; scaleIndex++)
			{
				var scale = Waagen[scaleIndex];
				<article class="scale-card">
					<div class="scale-card-header">
						<div>
							<span class="card-kicker">@(scaleIndex == 0 ? "Hauptwaage" : "Nebenwaage")</span>
							<h2>@(PeerMode == "join" ? PeerScaleStatuses[scaleIndex] : GewichtsStatus(scale))</h2>
						</div>
						<span class="scale-icon" aria-hidden="true">⚖</span>
					</div>
					<div class="scale-panels">
						<div class="pan">
							<span class="pan-label">Links</span>
							<div class="placed-stones">
								@foreach (var stone in scale.LinkeSeite)
								{
									<span class="mini-stone @StoneClass(stone)">@stone.Farbe</span>
								}
							</div>
						</div>
						<div class="pan-divider">vs.</div>
						<div class="pan">
							<span class="pan-label">Rechts</span>
							<div class="placed-stones">
								@foreach (var stone in scale.RechteSeite)
								{
									<span class="mini-stone @StoneClass(stone)">@stone.Farbe</span>
								}
							</div>
						</div>
					</div>
				</article>
			}
		</section>

		<section class="selection-panel">
			<div class="section-heading">
				<div>
					<span class="card-kicker">Steine von @Manager.HoleAktuelleGruppe().Name</span>
					<h2>Stein auswählen</h2>
				</div>
				<span class="remaining-count">@VerbleibendeSteine() verfügbar</span>
			</div>

			<div class="stone-grid">
				@foreach (var item in Manager.HoleAktuelleGruppe().Steine.Select((stone, index) => new { stone, index }))
				{
					<button class="stone-button @StoneClass(item.stone) @(SelectedStone == item.stone ? "selected" : "")"
							disabled="@(item.stone.Platziert || SpielBeendet || !CanControlCurrentTeam)"
							@onclick="() => SelectStone(item.stone)">
						<span class="stone-dot"></span>
						<span>@item.stone.Farbe</span>
						<small>@SteinHinweis(item.stone)</small>
					</button>
				}
			</div>

			@if (SelectedStone is not null)
			{
				<div class="placement-controls">
					<div>
						<span class="card-kicker">@SelectedStone.Farbe ausgewählt</span>
						<strong>Wo soll der Stein liegen?</strong>
					</div>
					<div class="placement-actions">
						@for (var scaleIndex = 0; scaleIndex < Waagen.Count; scaleIndex++)
						{
							var targetScale = scaleIndex;
							<button class="target-button" @onclick="() => PlaceSelectedStone(targetScale, true)">@(targetScale == 0 ? "Hauptwaage" : "Nebenwaage"), links</button>
							<button class="target-button" @onclick="() => PlaceSelectedStone(targetScale, false)">@(targetScale == 0 ? "Hauptwaage" : "Nebenwaage"), rechts</button>
						}
					</div>
				</div>
			}
		</section>

		<section class="action-row">
			<button class="primary-action" disabled="@(!CanEvaluate || SpielBeendet)" @onclick="EvaluateGame">Zug beenden <span>→</span></button>
			@if (CanGuessWeights && !SpielBeendet)
			{
				<button class="secondary-action" type="button" @onclick="ShowWeightGuess">Gewichte raten</button>
			}
			<button class="secondary-action" @onclick="ResetGame">Neue Partie</button>
		</section>
		<p class="rules-note"><strong>Zug beenden</strong> gibt den Zug frei, sobald die aktuelle Gruppe mindestens zwei eigene Steine platziert hat oder die belegte Hauptwaage ausgeglichen ist. Die Gewichtsabfrage ist freiwillig.</p>

		@if (GewichteRatenSichtbar)
		{
			<section class="guess-panel">
				<div class="section-heading">
					<div>
						<span class="card-kicker">Hauptwaage ausgeglichen</span>
						<h2>Wie schwer sind die Farben?</h2>
					</div>
				</div>
				<p class="guess-note">Trage für jede Farbe das vermutete Gewicht ein.</p>
				<div class="guess-grid">
					@foreach (var color in Farben)
					{
						<label class="guess-field">
							<span class="mini-stone @color.ToLowerInvariant()">@color</span>
							<input type="number" min="1" @bind="GewichtsTipps[color]" />
							<span>g</span>
						</label>
					}
				</div>
				<button class="primary-action" @onclick="CheckWeightGuess">Gewichte prüfen</button>
				@if (!string.IsNullOrWhiteSpace(GewichtsErgebnis))
				{
					<p class="guess-result" aria-live="polite">@GewichtsErgebnis</p>
				}
			</section>
		}
	</main>

	@if (SpielBeendet)
	{
		<section class="end-screen" role="dialog" aria-modal="true" aria-labelledby="end-title">
			<div class="end-card">
				<span class="end-kicker">Partie beendet</span>
				<div class="end-symbol @(SpielGewonnen ? "won" : "lost")" aria-hidden="true">
					@(SpielGewonnen ? "★" : "◆")
				</div>
				<h2 id="end-title">@(SpielGewonnen ? "Gewonnen!" : "Nicht gewonnen")</h2>
				<p>@(SpielGewonnen
					? "Alle Aufgaben wurden erfolgreich abgeschlossen."
					: "Die Hauptwaage oder die Gewichte waren am Ende nicht vollständig korrekt.")</p>

				<div class="end-result">
					<div>
						<span>Hauptwaage</span>
						<strong>@(PeerMode == "join"
							? (PeerScaleStatuses[0] == "Im Gleichgewicht" ? "Ausgeglichen" : "Nicht ausgeglichen")
							: (Waagen[0].IstAusbalanciert() ? "Ausgeglichen" : "Nicht ausgeglichen"))</strong>
					</div>
					<div>
						<span>Farben richtig</span>
						<strong>@RichtigGerateneFarben.Count von @Farben.Length</strong>
					</div>
				</div>

				<div class="end-actions">
					<button class="primary-action" type="button" @onclick="ResetGame">Neue Partie</button>
					<button class="secondary-action" type="button" @onclick="ResetGame">Zum Startbildschirm</button>
				</div>
			</div>
		</section>
	}
</div>
}

@code {
	[Inject] private IJSRuntime JSRuntime { get; set; } = default!;

	private SpielManager Manager = new(3);
	private readonly List<Waage> Waagen = new() { new Waage(), new Waage() };
	private readonly List<string> Gruppennamen = new() { "Gruppe 1", "Gruppe 2", "Gruppe 3" };
	private int AnzahlGruppen = 3;
	private bool SpielGestartet;
	private Stein? SelectedStone;
	private string StatusText = "Wähle einen Stein aus, um ihn auf einer Waage zu platzieren.";
	private readonly string[] Farben = { "Rot", "Lila", "Gelb", "Blau", "Grün" };
	private readonly Dictionary<string, int> GewichtsTipps = new();
	private readonly HashSet<string> RichtigGerateneFarben = new();
	private bool GewichteRatenSichtbar;
	private string GewichtsErgebnis = string.Empty;
	private bool SpielBeendet;
	private bool SpielGewonnen;

	private string PeerMode = "local";
	private string PeerRoomId = string.Empty;
	private string PeerTeamName = string.Empty;
	private string PeerConnectionStatus = string.Empty;
	private string PeerLocalId = string.Empty;
	private bool PeerJoining;
	private bool PeerJoined;
	private int PeerTeamIndex = -1;
	private readonly List<string> PeerScaleStatuses = new() { "Noch keine Steine platziert", "Noch keine Steine platziert" };
	private DotNetObjectReference<Home>? PeerDotNetReference;
	private readonly List<LobbyTeam> LobbyTeams = new();

	private void SetPeerMode(string mode)
	{
		PeerMode = mode;
		PeerConnectionStatus = string.Empty;
		PeerJoining = false;
		PeerJoined = false;
		if (mode != "host")
		{
			PeerRoomId = string.Empty;
		}
	}

	private async Task CreatePeerRoom()
	{
		PeerDotNetReference ??= DotNetObjectReference.Create(this);
		PeerConnectionStatus = "Raum wird erstellt...";
		await JS.InvokeVoidAsync("waagenPeer.createHost", PeerDotNetReference);
	}

	private async Task JoinPeerRoom()
	{
		if (PeerJoining || PeerJoined)
		{
			return;
		}

		PeerJoining = true;
		PeerConnectionStatus = "Verbindung wird hergestellt...";
		PeerDotNetReference ??= DotNetObjectReference.Create(this);
		PeerRoomId = PeerRoomId.Trim().ToUpperInvariant();
		await JS.InvokeVoidAsync("waagenPeer.joinRoom", PeerRoomId, PeerDotNetReference);
	}

	[JSInvokable]
	public async Task OnPeerEvent(string eventJson)
	{
		using var document = JsonDocument.Parse(eventJson);
		var root = document.RootElement;
		var type = root.GetProperty("type").GetString();

		switch (type)
		{
			case "host-ready":
				PeerRoomId = root.GetProperty("peerId").GetString() ?? string.Empty;
				PeerConnectionStatus = "Raum bereit.";
				break;
			case "joined-ready":
				PeerLocalId = root.GetProperty("peerId").GetString() ?? string.Empty;
				if (PeerJoined)
				{
					break;
				}
				PeerJoined = true;
				await JS.InvokeVoidAsync("waagenPeer.sendToHost", JsonSerializer.Serialize(new PeerMessage
				{
					Type = "join",
					TeamName = PeerTeamName.Trim()
				}));
				PeerConnectionStatus = "Beitritt gesendet.";
				break;
			case "peer-message":
				if (root.TryGetProperty("payload", out var hostPayload))
				{
					await HandlePeerMessage(root.GetProperty("peerId").GetString() ?? string.Empty, hostPayload);
				}
				break;
			case "host-message":
				if (root.TryGetProperty("payload", out var clientPayload))
				{
					await HandleHostMessage(clientPayload);
				}
				break;
			case "peer-disconnected":
				var disconnectedPeer = root.GetProperty("peerId").GetString();
				LobbyTeams.RemoveAll(team => team.PeerId == disconnectedPeer);
				await BroadcastLobby();
				break;
			case "host-disconnected":
				PeerConnectionStatus = "Die Verbindung zur Spielleitung wurde getrennt.";
				break;
			case "peer-error":
				PeerConnectionStatus = root.TryGetProperty("message", out var error)
					? $"Verbindungsfehler: {error.GetString()}"
					: "Verbindungsfehler.";
				PeerJoining = false;
				break;
		}

		await InvokeAsync(StateHasChanged);
	}

	private async Task HandlePeerMessage(string peerId, JsonElement payload)
	{
		var message = payload.Deserialize<PeerMessage>();
		if (message is null)
		{
			return;
		}

		switch (message.Type)
		{
			case "join":
				var existing = LobbyTeams.FirstOrDefault(team => team.PeerId == peerId);
				if (existing is null)
				{
					LobbyTeams.Add(new LobbyTeam
					{
						PeerId = peerId,
						Name = string.IsNullOrWhiteSpace(message.TeamName) ? $"Team {LobbyTeams.Count + 1}" : message.TeamName
					});
				}
				else
				{
					existing.Name = message.TeamName ?? existing.Name;
				}
				await BroadcastLobby();
				break;
			case "place":
				if (SpielGestartet && IsPeerTeamActive(peerId))
				{
					SelectedStone = Manager.HoleAktuelleGruppe().Steine
						.FirstOrDefault(stone => stone.Farbe == message.Color && !stone.Platziert);
					PlaceSelectedStoneHost(message.ScaleIndex, message.Left);
					await BroadcastGameState();
				}
				break;
			case "evaluate":
				if (SpielGestartet && IsPeerTeamActive(peerId))
				{
					EvaluateGame();
					await BroadcastGameState();
				}
				break;
		}
	}

	private async Task HandleHostMessage(JsonElement payload)
	{
		var message = payload.Deserialize<PeerMessage>();
		if (message is null)
		{
			return;
		}

		switch (message.Type)
		{
			case "lobby":
				if (message.Teams is not null)
				{
					LobbyTeams.Clear();
					LobbyTeams.AddRange(message.Teams);
					PeerTeamIndex = LobbyTeams.FindIndex(team => team.PeerId == PeerLocalId);
					PeerJoining = false;
					PeerConnectionStatus = PeerTeamIndex >= 0
						? "Erfolgreich verbunden. Warte auf den Spielstart."
						: "Verbindung hergestellt.";
				}
				break;
			case "game-state":
				if (message.Game is not null)
				{
					ApplyPeerGameState(message.Game);
					PeerTeamIndex = LobbyTeams.FindIndex(team => team.PeerId == PeerLocalId);
				}
				break;
		}
	}

	private bool IsPeerTeamActive(string peerId)
	{
		var index = Manager.AktuelleGruppe;
		return index >= 0 && index < LobbyTeams.Count && LobbyTeams[index].PeerId == peerId;
	}

	private async Task BroadcastLobby()
	{
		await JS.InvokeVoidAsync("waagenPeer.broadcast", JsonSerializer.Serialize(new PeerMessage
		{
			Type = "lobby",
			Teams = LobbyTeams.Select(team => new LobbyTeam
			{
				PeerId = team.PeerId,
				Name = team.Name
			}).ToList()
		}));
		await InvokeAsync(StateHasChanged);
	}

	private async Task BroadcastGameState()
	{
		await JS.InvokeVoidAsync("waagenPeer.broadcast", JsonSerializer.Serialize(new PeerMessage
		{
			Type = "game-state",
			Game = CreatePeerGameState()
		}));
		await InvokeAsync(StateHasChanged);
	}

	private void GruppenanzahlGeaendert()
	{
		while (Gruppennamen.Count < AnzahlGruppen)
		{
			Gruppennamen.Add($"Gruppe {Gruppennamen.Count + 1}");
		}
	}

	private void StartGame()
	{
		GruppenanzahlGeaendert();
		Manager = new SpielManager(AnzahlGruppen);
		for (var index = 0; index < AnzahlGruppen; index++)
		{
			Manager.Gruppen[index].Name = string.IsNullOrWhiteSpace(Gruppennamen[index])
				? $"Gruppe {index + 1}"
				: Gruppennamen[index].Trim();
		}

		SpielGestartet = true;
		SpielBeendet = false;
		SpielGewonnen = false;
		RichtigGerateneFarben.Clear();
		GewichteRatenSichtbar = false;
		SelectedStone = null;
		StatusText = $"{Manager.HoleAktuelleGruppe().Name} beginnt. Wähle einen Stein aus.";
	}

	private async Task StartPeerGame()
	{
		if (LobbyTeams.Count == 0)
		{
			return;
		}

		Manager = new SpielManager(LobbyTeams.Count);
		ClearScales();
		for (var index = 0; index < LobbyTeams.Count; index++)
		{
			var team = LobbyTeams[index];
			Manager.Gruppen[index].Name = team.Name;
		}

		PeerMode = "host";
		SpielGestartet = true;
		SpielBeendet = false;
		SpielGewonnen = false;
		RichtigGerateneFarben.Clear();
		GewichteRatenSichtbar = false;
		SelectedStone = null;
		StatusText = $"{Manager.HoleAktuelleGruppe().Name} beginnt. Das Team platziert seine Steine.";
		await BroadcastGameState();
	}

	private void SelectStone(Stein stone)
	{
		if (!stone.Platziert && !SpielBeendet)
		{
			SelectedStone = stone;
			StatusText = $"{stone.Farbe} ausgewählt. Wähle jetzt eine Seite.";
		}
	}

	private void PlaceSelectedStone(int scaleIndex, bool left)
	{
		if (SelectedStone is null || SelectedStone.Platziert)
		{
			return;
		}

		if (PeerMode == "join")
		{
			_ = JS.InvokeVoidAsync("waagenPeer.sendToHost", JsonSerializer.Serialize(new PeerMessage
			{
				Type = "place",
				Color = SelectedStone.Farbe,
				ScaleIndex = scaleIndex,
				Left = left
			}));
			SelectedStone = null;
			return;
		}

		if (left)
		{
			if (scaleIndex == 0 && !IstHauptwaagenKombinationGueltig(true))
			{
				StatusText = "Nicht möglich: Auf der Hauptwaage dürfen links und rechts nicht dieselben Steine liegen.";
				return;
			}

			Waagen[scaleIndex].SteiLinksPlatzieren(SelectedStone);
		}
		else
		{
			if (scaleIndex == 0 && !IstHauptwaagenKombinationGueltig(false))
			{
				StatusText = "Nicht möglich: Auf der Hauptwaage dürfen links und rechts nicht dieselben Steine liegen.";
				return;
			}

			Waagen[scaleIndex].SteinRechtsPlatzieren(SelectedStone);
		}

			StatusText = $"{SelectedStone.Farbe} liegt auf {(scaleIndex == 0 ? "der Hauptwaage" : "der Nebenwaage")}.";
		SelectedStone = null;
	}

	private void PlaceSelectedStoneHost(int scaleIndex, bool left)
	{
		if (SelectedStone is null)
		{
			return;
		}

		if (left)
		{
			if (scaleIndex == 0 && !IstHauptwaagenKombinationGueltig(true))
			{
				StatusText = "Nicht möglich: Auf der Hauptwaage dürfen links und rechts nicht dieselben Steine liegen.";
				return;
			}
			Waagen[scaleIndex].SteiLinksPlatzieren(SelectedStone);
		}
		else
		{
			if (scaleIndex == 0 && !IstHauptwaagenKombinationGueltig(false))
			{
				StatusText = "Nicht möglich: Auf der Hauptwaage dürfen links und rechts nicht dieselben Steine liegen.";
				return;
			}
			Waagen[scaleIndex].SteinRechtsPlatzieren(SelectedStone);
		}

		StatusText = $"{SelectedStone.Farbe} liegt auf {(scaleIndex == 0 ? "der Hauptwaage" : "der Nebenwaage")}.";
		SelectedStone = null;
	}

	private void EvaluateGame()
	{
		if (!CanEvaluate || SpielBeendet)
		{
			return;
		}

		if (PeerMode == "join")
		{
			_ = JS.InvokeVoidAsync("waagenPeer.sendToHost", JsonSerializer.Serialize(new PeerMessage
			{
				Type = "evaluate"
			}));
			return;
		}

		var mainScale = Waagen[0];
		var group = Manager.HoleAktuelleGruppe();
		var isBalanced = mainScale.IstAusbalanciert();
		SelectedStone = null;
		GewichteRatenSichtbar = false;

		if (AlleSteinePlatziert())
		{
			SpielBeendet = true;
			SpielGewonnen = isBalanced && RichtigGerateneFarben.Count == Farben.Length;
			StatusText = SpielGewonnen
				? "Gewonnen! Alle Steine sind platziert, die Hauptwaage ist ausgeglichen und alle Gewichte wurden richtig geraten."
				: "Verloren. Alle Steine sind platziert, aber die Hauptwaage ist nicht ausgeglichen oder nicht alle Gewichte wurden richtig geraten.";
			return;
		}

		if (Manager.NaechsteGruppe())
		{
			StatusText = isBalanced
				? $"{group.Name} beendet den Zug. Die Hauptwaage ist ausgeglichen. Die Waagen bleiben liegen; {Manager.HoleAktuelleGruppe().Name} ist jetzt dran."
				: $"{group.Name} beendet den Zug. Die Waagen bleiben liegen; {Manager.HoleAktuelleGruppe().Name} ist jetzt dran.";
		}
		else
		{
			StatusText = isBalanced
				? "Alle Gruppen waren an der Reihe. Die Hauptwaage ist ausgeglichen."
				: "Alle Gruppen waren an der Reihe. Starte eine neue Partie für einen weiteren Durchgang.";
		}
	}

	private void ResetGame()
	{
		SpielGestartet = false;
		Manager = new SpielManager(AnzahlGruppen);
		ClearScales();
		SelectedStone = null;
		SpielBeendet = false;
		SpielGewonnen = false;
		RichtigGerateneFarben.Clear();
		GewichteRatenSichtbar = false;
		PeerJoining = false;
		PeerJoined = false;
		PeerTeamIndex = -1;
		LobbyTeams.Clear();
		PeerRoomId = string.Empty;
		StatusText = "Wähle die Gruppen und starte eine neue Partie.";
	}

	private void ClearScales()
	{
		foreach (var scale in Waagen)
		{
			scale.LinkeSeite.Clear();
			scale.RechteSeite.Clear();
		}
	}

	private int VerbleibendeSteine() => Manager.HoleAktuelleGruppe().Steine.Count(stone => !stone.Platziert);

	private bool CanControlCurrentTeam
	{
		get
		{
			if (PeerMode == "local" || PeerMode == "host")
			{
				return PeerMode == "local";
			}

			return PeerTeamIndex >= 0 && PeerTeamIndex == Manager.AktuelleGruppe;
		}
	}

	private bool CanEvaluate => Manager.HoleAktuelleGruppe().Steine.Count(stone => stone.Platziert) >= 2 || CanGuessWeights;

	private bool CanGuessWeights => PeerMode != "join"
		&& Waagen[0].LinkeSeite.Count + Waagen[0].RechteSeite.Count > 0
		&& Waagen[0].GewichtLinks() == Waagen[0].GewichtRechts();

	private bool AlleSteinePlatziert() => Manager.Gruppen.SelectMany(group => group.Steine).All(stone => stone.Platziert);

	private void ShowWeightGuess()
	{
		GewichteRatenSichtbar = true;
		foreach (var color in Farben)
		{
			GewichtsTipps[color] = 0;
		}
		GewichtsErgebnis = string.Empty;
		StatusText = "Die Hauptwaage ist ausgeglichen. Trage die vermuteten Farbgewichte ein.";
	}

	private void CheckWeightGuess()
	{
		var fehlendeFarben = Farben.Where(color => !GewichtsTipps.TryGetValue(color, out var guess) || guess <= 0).ToList();
		if (fehlendeFarben.Count > 0)
		{
			GewichtsErgebnis = $"Bitte gib noch ein Gewicht für {string.Join(", ", fehlendeFarben)} ein.";
			StatusText = "Die Gewichtsangaben sind noch unvollständig.";
			return;
		}

		var richtigeFarben = Farben.Where(color =>
			Manager.Gruppen.SelectMany(group => group.Steine)
				.Where(stone => stone.Farbe == color)
				.All(stone => stone.Gewicht == GewichtsTipps[color])).ToList();
		foreach (var color in richtigeFarben)
		{
			RichtigGerateneFarben.Add(color);
		}

		if (RichtigGerateneFarben.Count == Farben.Length)
		{
			GewichtsErgebnis = "Richtig! Alle fünf Farbgewichte wurden erraten.";
			StatusText = "Richtig! Alle Gewichte wurden korrekt erraten.";
		}
		else
		{
			GewichtsErgebnis = $"Noch nicht vollständig richtig: {richtigeFarben.Count} von {Farben.Length} Gewichten stimmen in diesem Versuch. Insgesamt richtig geraten: {RichtigGerateneFarben.Count} von {Farben.Length}.";
			StatusText = "Einige Gewichte stimmen noch nicht. Versuche es erneut.";
		}
	}

	private bool IstHauptwaagenKombinationGueltig(bool left)
	{
		if (SelectedStone is null)
		{
			return false;
		}

		var leftColors = Waagen[0].LinkeSeite.Select(stone => stone.Farbe).ToList();
		var rightColors = Waagen[0].RechteSeite.Select(stone => stone.Farbe).ToList();
		(left ? leftColors : rightColors).Add(SelectedStone.Farbe);

		return !leftColors.OrderBy(color => color).SequenceEqual(rightColors.OrderBy(color => color));
	}

	private PeerGameState CreatePeerGameState()
	{
		return new PeerGameState
		{
			StatusText = StatusText,
			CurrentTeam = Manager.AktuelleGruppe,
			SpielBeendet = SpielBeendet,
			SpielGewonnen = SpielGewonnen,
			RichtigGerateneFarben = RichtigGerateneFarben.Count,
			Teams = Manager.Gruppen.Select(group => new TeamGameSnapshot
			{
				Name = group.Name,
				Stones = group.Steine.Select(stone => new StoneGameSnapshot
				{
					Color = stone.Farbe,
					Placed = stone.Platziert
				}).ToList()
			}).ToList(),
			Scales = Waagen.Select(scale => new ScaleGameSnapshot
			{
				StatusText = GewichtsStatus(scale),
				Left = scale.LinkeSeite.Select(stone => new StoneGameSnapshot
				{
					Color = stone.Farbe,
					Placed = stone.Platziert
				}).ToList(),
				Right = scale.RechteSeite.Select(stone => new StoneGameSnapshot
				{
					Color = stone.Farbe,
					Placed = stone.Platziert
				}).ToList()
			}).ToList()
		};
	}

	private void ApplyPeerGameState(PeerGameState state)
	{
		Manager = new SpielManager(state.Teams.Count);
		Manager.AktuelleGruppe = state.CurrentTeam;

		for (var teamIndex = 0; teamIndex < state.Teams.Count; teamIndex++)
		{
			var team = state.Teams[teamIndex];
			Manager.Gruppen[teamIndex].Name = team.Name;
			for (var stoneIndex = 0; stoneIndex < team.Stones.Count; stoneIndex++)
			{
				var stone = team.Stones[stoneIndex];
				Manager.Gruppen[teamIndex].Steine[stoneIndex].Farbe = stone.Color;
				Manager.Gruppen[teamIndex].Steine[stoneIndex].Platziert = stone.Placed;
			}
		}

		ClearScales();
		for (var scaleIndex = 0; scaleIndex < state.Scales.Count && scaleIndex < Waagen.Count; scaleIndex++)
		{
			PeerScaleStatuses[scaleIndex] = state.Scales[scaleIndex].StatusText;
			foreach (var stoneSnapshot in state.Scales[scaleIndex].Left)
			{
				Waagen[scaleIndex].LinkeSeite.Add(new Stein(stoneSnapshot.Color, 0)
				{
					Platziert = true
				});
			}
			foreach (var stoneSnapshot in state.Scales[scaleIndex].Right)
			{
				Waagen[scaleIndex].RechteSeite.Add(new Stein(stoneSnapshot.Color, 0)
				{
					Platziert = true
				});
			}
		}

		StatusText = state.StatusText;
		SpielBeendet = state.SpielBeendet;
		SpielGewonnen = state.SpielGewonnen;
		RichtigGerateneFarben.Clear();
		for (var index = 0; index < state.RichtigGerateneFarben; index++)
		{
			RichtigGerateneFarben.Add(Farben[index]);
		}
		SelectedStone = null;
		SpielGestartet = true;
		PeerMode = "join";
		InvokeAsync(StateHasChanged);
	}

	private sealed class LobbyTeam
	{
		public string PeerId { get; set; } = string.Empty;
		public string Name { get; set; } = string.Empty;
	}

	private sealed class PeerMessage
	{
		public string Type { get; set; } = string.Empty;
		public string? TeamName { get; set; }
		public List<LobbyTeam>? Teams { get; set; }
		public PeerGameState? Game { get; set; }
		public string? Color { get; set; }
		public int ScaleIndex { get; set; }
		public bool Left { get; set; }
	}

	private sealed class PeerGameState
	{
		public string StatusText { get; set; } = string.Empty;
		public int CurrentTeam { get; set; }
		public bool SpielBeendet { get; set; }
		public bool SpielGewonnen { get; set; }
		public int RichtigGerateneFarben { get; set; }
		public List<TeamGameSnapshot> Teams { get; set; } = new();
		public List<ScaleGameSnapshot> Scales { get; set; } = new();
	}

	private sealed class TeamGameSnapshot
	{
		public string Name { get; set; } = string.Empty;
		public List<StoneGameSnapshot> Stones { get; set; } = new();
	}

	private sealed class StoneGameSnapshot
	{
		public string Color { get; set; } = string.Empty;
		public bool Placed { get; set; }
	}

	private sealed class ScaleGameSnapshot
	{
		public string StatusText { get; set; } = "Noch keine Steine platziert";
		public List<StoneGameSnapshot> Left { get; set; } = new();
		public List<StoneGameSnapshot> Right { get; set; } = new();
	}

	private static string GewichtsStatus(Waage scale)
	{
		if (scale.LinkeSeite.Count == 0 && scale.RechteSeite.Count == 0)
		{
			return "Noch keine Steine platziert";
		}

		if (scale.GewichtLinks() == scale.GewichtRechts())
		{
			return "Im Gleichgewicht";
		}

		return scale.GewichtLinks() > scale.GewichtRechts()
			? "Linke Seite schwerer"
			: "Rechte Seite schwerer";
	}

	private static string StoneClass(Stein stone) => stone.Farbe.ToLowerInvariant();

	private static string SteinHinweis(Stein stone) => stone.Platziert ? "platziert" : "unbekannt";
}
