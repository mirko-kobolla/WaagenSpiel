<Window x:Class="WaagenSpiel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waagen Spiel"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Überschrift -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="Waagen-Spiel"
                       FontSize="42"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Das große Klassen Waagen-Spiel"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Auswahl der Gruppen -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center">
            <TextBlock Text="Anzahl der Gruppen:"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <ComboBox x:Name="Gruppenauswahl"
                      Width="180"
                      Height="40"
                      FontSize="18"
                      HorizontalContentAlignment="Center">
                <ComboBoxItem Content="6 Gruppen"
                    IsSelected="True"/>
                <ComboBoxItem Content="7 Gruppen"/>
            </ComboBox>

            <Button x:Name="StartButton"
                    Content="SPIEL STARTEN"
                    Width="200"
                    Height="55"
                    FontSize="20"
                    FontWeight="Bold"
                    Margin="0,25,0,0"
                    Click="StartButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
