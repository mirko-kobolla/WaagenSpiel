<Window x:Class="WaagenSpiel.SpielWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Waagen-Spiel" Height="850" Width="1200"
        Background="#F5F6F8">
    <!-- Heller, moderner Hintergrund statt Standard-Weiß -->

    <Grid Margin="24">
        <!-- 4 Zeilen definiert: Kopf, Hauptwaage, Zweitwaage, Steine-Bereich -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Reihe 0: Kopfbereich -->
            <RowDefinition Height="*"/>
            <!-- Reihe 1: Hauptwaage -->
            <RowDefinition Height="*"/>
            <!-- Reihe 2: Zweitwaage -->
            <RowDefinition Height="Auto"/>
            <!-- Reihe 3: Steine-Bereich -->
        </Grid.RowDefinitions>

        <!-- ================= KOPFBEREICH (Reihe 0) ================= -->
        <Border Grid.Row="0" 
                Background="#FFFFFF" 
                CornerRadius="8" 
                Padding="16,12" 
                Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="GruppenText"
                           Text="Gruppe 1 ist an der Reihe"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#2C3E50"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="RundenText"
                           Grid.Column="1"
                           Text="Runde: 1"
                           FontSize="20"
                           FontWeight="Medium"
                           Foreground="#7F8C8D"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= HAUPTWAAGE (Reihe 1) ================= -->
        <GroupBox Grid.Row="1" 
                  Header="HAUPTWAAGE"
                  FontSize="16"
                  FontWeight="Bold"
                  Foreground="#2C3E50"
                  Margin="0,0,0,16">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <!-- Feste Breite für das Icon sorgt für Stabilität -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Linke Seite -->
                <ListBox x:Name="HauptwaageLinks"
                         Grid.Column="0"
                         FontSize="18"
                         Foreground="#263238"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListBox.Resources>

                 </ListBox>

                <!-- Waage Icon -->
                <TextBlock x:Name="HauptwaageIcon"
                           Grid.Column="1"
                           Text="⚖"
                           FontSize="72"
                           Foreground="#2980B9" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="HauptwaageStatus"
                           Grid.Column="1"
                           Text="AUSGEGLICHEN"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,10"/>

                <!-- Rechte Seite -->
                <ListBox x:Name="HauptwaageRechts"
                         Grid.Column="2"
                         FontSize="18"
                         Foreground="#263238"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListBox.Resources>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- ================= ZWEITWAAGE (Reihe 2) ================= -->
        <GroupBox Grid.Row="2" 
                  Header="ZWEITWAAGE-HILFSWAAGE"
                  FontSize="16"
                  FontWeight="Bold"
                  Foreground="#2C3E50"
                  Margin="0,0,0,16">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Linke Seite -->
                <ListBox x:Name="ZweitwaageLinks"
                         Grid.Column="0"
                         FontSize="18"
                         Foreground="#263238"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListBox.Resources>
                </ListBox>

                <!-- Waage Icon -->
                <TextBlock x:Name="ZweitwaageIcon"
                           Grid.Column="1"
                           Text="⚖"
                           FontSize="64"
                           Foreground="#16A085" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="ZweitwaageStatus"
                           Grid.Column="1"
                           Text="AUSGEGLICHEN"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,10"/>
                <!-- Rechte Seite -->
                <ListBox x:Name="ZweitwaageRechts"
                         Grid.Column="2"
                         FontSize="18"
                         Foreground="#263238"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    
                    <ListBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </ListBox.Resources>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- ================= UNTERER BEREICH (Reihe 3) ================= -->
        <GroupBox Grid.Row="3"
                  Header="Steine der aktuellen Gruppe"
                  FontSize="16"
                  FontWeight="Bold"
                  Foreground="#2C3E50">
            <StackPanel Margin="12">
                <WrapPanel x:Name="SteinnePanel"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="StatusText"
                           Text="Wähle einen Stein aus"
                           FontSize="16"
                           FontWeight="Normal"
                           Foreground="#E67E22" 
                           HorizontalAlignment="Center"/>

                <WrapPanel HorizontalAlignment="Center"
                           Margin="5">

                    <Button Content="Hauptwaage ←"
                            Width="160"
                            Height="45"
                            Margin="5"
                            Click="HauptwaagenLinks_Click"/>

                    <Button Content="Hauptwaage →"
                      Width="160"
                      Height="45"
                      Margin="5"
                      Click="HauptwaagenRechts_Click"/>

                    <Button Content="Zweitwaage ←"
                            Width="160"
                            Height="45"
                            Margin="5"
                            Click="ZweitwaagenLinks_Click"/>

                    <Button Content="Zweitwaage →"
                            Width="160"
                            Height="45"
                            Margin="5"
                            Click="ZweitwaagenRechts_Click"/>


                    <Button Content="Nächste Gruppe =>"
                            Width="180"
                            Height="45"
                            Margin="5"
                            Click="NaechsteGruppe_Click"/>

                    <Button Content="Gruppe raus X"
                            Width="120"
                            Height="45"
                            Margin="5"
                            Click="GruppeRaus_Click"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

    </Grid>
</Window>

    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    